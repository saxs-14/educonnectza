rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isDevAdmin() {
      // Role comes solely from the user's own Firestore document - no
      // hardcoded-identity shortcuts. Set via the DevAdmin bootstrap script
      // (scripts/init-dev-admin.mjs), which writes role: 'devAdmin' there.
      return isAuthenticated() && getUserRole() == 'devAdmin';
    }
    
    function isSchoolAdmin() {
      return isAuthenticated() && getUserRole() == 'SchoolAdmin';
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'Teacher';
    }

    match /users/{userId} {
      // DevAdmins can read/write all users
      // Users can read their own profile
      allow read: if isDevAdmin() || request.auth.uid == userId || isSchoolAdmin();
      allow write: if isDevAdmin() || isSchoolAdmin() || 
        // Allow self-registration only if setting a valid, non-admin role
        (request.auth.uid == userId && (request.resource.data.role == 'Teacher' || request.resource.data.role == 'Learner'));
    }
    
    // Add additional rules for other collections as needed.
    // DevAdmin has full access to everything.
    match /{document=**} {
      allow read, write: if isDevAdmin();
    }
  }
}
