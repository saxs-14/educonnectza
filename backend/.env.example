PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/educonnectza?retryWrites=true&w=majority
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
CLIENT_URL=http://localhost:3000
# Comma-separate multiple allowed origins if the frontend is served from more than one URL.

# Used only by backend/seed.js and scripts/init-dev-admin.{js,mjs} to
# create/update the one DevAdmin account. Never commit real values here -
# this file is the template; put the real credential in backend/.env only.
DEV_ADMIN_EMAIL=devadmin@example.com
DEV_ADMIN_PASSWORD=<set a strong password, do not commit>
